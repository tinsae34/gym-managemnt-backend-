# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gym_management_db?schema=public"

# AfroMessage SMS API Configuration
AFROMESSAGE_API_TOKEN=your_afromessage_api_token_here
AFROMESSAGE_SENDER_ID=GYM_MGMT

# Cron Job Configuration
CRON_SCHEDULE="0 9 * * *"
ENABLE_CRON_JOBS=true
